# Copy to .env and fill in. Never commit .env.
# Render: set these in the dashboard, not in a committed file.

# MongoDB Atlas connection string (contains the password)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/footboard?retryWrites=true&w=majority

# Throwaway database for integration tests. Name MUST end in _test.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/footboard_test?retryWrites=true&w=majority

# API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ML service (Python / FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Web (Vite). Read at build time.
VITE_API_URL=http://localhost:3000/api
