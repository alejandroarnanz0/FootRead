# ─────────────────────────────────────────────────────────────────────────────
# Footboard · environment variables
#
#   1. Copy this file to `.env` in the REPO ROOT (next to this file):
#        cp .env.example .env
#   2. Fill in the values marked  <-- FILL IN.
#   3. NEVER commit `.env` (it is in .gitignore). It holds passwords.
#
# There is ONE .env for the whole repo: the API, the web (Vite) and the scripts
# all read this same file.
# On Render, these go in each service's dashboard, not in a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Alejandro sends you both connection strings privately. Do not paste them anywhere else.
#
# REAL data (Transfermarkt players, StatsBomb shots and matches).
# Your code may READ from it. Scripts that WRITE must use MONGODB_URI_TEST instead.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/footboard?retryWrites=true&w=majority   # <-- FILL IN
#
# Disposable database for tests and experiments. Its name MUST end in _test:
# the tests refuse to run otherwise. Anything here can be wiped at any time.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/footboard_test?retryWrites=true&w=majority   # <-- FILL IN

# ── API (Express) ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# The web origin allowed by CORS. Change it only if Vite runs on another port.
CORS_ORIGIN=http://localhost:5173

# JWT. At least 32 random bytes; the API refuses to start without it. Generate yours with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<random-hex-string>   # <-- FILL IN (your own, never share it)
JWT_EXPIRES_IN=1h

# ── xG service (Python / FastAPI, runs in Docker) ────────────────────────────
ML_SERVICE_URL=http://localhost:8000
# How long the API waits for the xG service before giving up (ms).
ML_TIMEOUT_MS=3000
# Which trained run (folder in ml/OUTPUT_AI/) the service loads. Empty = the latest.
MODEL_RUN=2026-11-20_1949

# ── Scripts that use the API as a user (match replayer, simulated user) ──────
# A user registered in the app (sign up once in the web at /login).
REPLAY_EMAIL=   # <-- FILL IN
REPLAY_PASSWORD=   # <-- FILL IN

# ── Web (Vite) ───────────────────────────────────────────────────────────────
# Read when Vite starts / builds: restart `npm run dev` after changing it.
VITE_API_URL=http://localhost:3000/api
