{
  "name": "footboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "Footboard backend: Express + Mongoose",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "start:test": "node scripts/start-test-api.js",
    "seed": "node scripts/seed.js",
    "etl": "node scripts/etl/run-all.js",
    "etl:wipe": "node scripts/etl/wipe.js",
    "etl:shots": "node scripts/etl/shots.js",
    "etl:matches": "node scripts/etl/matches.js",
    "replay": "node scripts/replay.js",
    "value": "node scripts/value/run.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
